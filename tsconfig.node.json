  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "postcss.config.mjs"]
}
